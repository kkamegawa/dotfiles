# ~/.zshrc — 対話 zsh 設定
# 非対話シェルの PATH は ~/.profile で管理

# ~/.profile を source（非対話シェルでも PATH が揃うよう）
[ -f "$HOME/.profile" ] && source "$HOME/.profile"

# mise activate（対話シェルでは shims の代わりに activate を使う）
{{ if or .isLinux .isMac }}
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi
{{ end }}

# Oh My Posh
{{ if .isMac }}
if command -v oh-my-posh &>/dev/null; then
  _omp_config="$HOME/.config/oh-my-posh/mytheme.omp.json"
  if [[ -f "$_omp_config" ]]; then
    eval "$(oh-my-posh init zsh --config "$_omp_config")"
  else
    eval "$(oh-my-posh init zsh)"
  fi
fi
{{ end }}

# fzf / Ctrl+R history search
_dotfiles_fzf_loaded=0
{{ if .isMac }}
if command -v brew &>/dev/null; then
  _fzf_prefix="$(brew --prefix fzf 2>/dev/null)"
  if [[ -n "$_fzf_prefix" ]]; then
    [ -f "$_fzf_prefix/shell/completion.zsh" ] && source "$_fzf_prefix/shell/completion.zsh"
    if [ -f "$_fzf_prefix/shell/key-bindings.zsh" ]; then
      source "$_fzf_prefix/shell/key-bindings.zsh"
      _dotfiles_fzf_loaded=1
    fi
  fi
fi
{{ else if .isLinux }}
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
  _dotfiles_fzf_loaded=1
elif [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  _dotfiles_fzf_loaded=1
fi
{{ end }}

if [ "$_dotfiles_fzf_loaded" -eq 0 ]; then
  bindkey '^R' history-incremental-search-backward
  bindkey -M emacs '^R' history-incremental-search-backward
  bindkey -M viins '^R' history-incremental-search-backward
fi
unset _dotfiles_fzf_loaded
unset _fzf_prefix

# エイリアス
alias ls='ls --color=auto'
alias ll='ls -lah'
alias grep='grep --color=auto'

# 補完
autoload -Uz compinit && compinit -C

# ヒストリ
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# User additions
# Put machine-local zsh customizations in ~/.zshrc.local.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

bindkey "^[[3;5~" kill-word
bindkey -e
bindkey "^[[3~"   delete-char        # Delete
bindkey "^[[3;5~" kill-word          # Ctrl+Delete
bindkey "^W"      backward-kill-word # Ctrl+Backspace
