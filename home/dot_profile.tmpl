#!/bin/sh
# ~/.profile — POSIX 互換の共通環境変数
# 非対話シェル（IDE, スクリプト, CI）でも PATH が揃うよう、
# すべてのシェル起動ファイルからここを source する。

# Refresh managed macOS .NET state before the profile guard so repeated sourcing
# after path_helper remains safe and repairs inherited stale environment values.
{{ if eq .chezmoi.os "darwin" }}
DOTFILES_DOTNET_ROOT="$HOME/.local/share/mise/dotnet-root"
export DOTNET_ROOT="$DOTFILES_DOTNET_ROOT"
if [ "$(sysctl -in hw.optional.arm64 2>/dev/null || true)" = "1" ] || [ "$(uname -m)" = "arm64" ]; then
  export DOTNET_ROOT_ARM64="$DOTFILES_DOTNET_ROOT"
  unset DOTNET_ROOT_X64
else
  export DOTNET_ROOT_X64="$DOTFILES_DOTNET_ROOT"
  unset DOTNET_ROOT_ARM64
fi

_dotfiles_remove_path_entry() {
  PATH=$(printf '%s\n' "$PATH" | awk -v remove="$1" -F: '{
    result = ""
    for (i = 1; i <= NF; i++) {
      if ($i != remove) {
        if (result != "") result = result ":"
        result = result $i
      }
    }
    print result
  }')
}
_dotfiles_remove_path_entry "$DOTFILES_DOTNET_ROOT"
_dotfiles_remove_path_entry "$HOME/.dotnet/tools"
if [ -d "$HOME/.dotnet/tools" ]; then
  PATH="$HOME/.dotnet/tools:$PATH"
fi
if [ -x "$DOTFILES_DOTNET_ROOT/dotnet" ]; then
  PATH="$DOTFILES_DOTNET_ROOT:$PATH"
fi
unset -f _dotfiles_remove_path_entry
export PATH
unset DOTFILES_DOTNET_ROOT
{{ end }}

# Prevent repeated setup while allowing the macOS runtime refresh above.
[ -n "$__DOTFILES_PROFILE_LOADED" ] && return
export __DOTFILES_PROFILE_LOADED=1

# Homebrew (macOS / Linux)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# mise shims（非対話シェル向け PATH 注入）
{{- if eq .chezmoi.os "windows" }}
if [ -d "$LOCALAPPDATA/mise/shims" ]; then
  export PATH="$(cygpath -u "$LOCALAPPDATA")/mise/shims:$PATH"
fi
{{- else }}
if [ -d "$HOME/.local/share/mise/shims" ]; then
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi
{{- end }}

# uv
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Go
if [ -d "$HOME/go/bin" ]; then
  export PATH="$HOME/go/bin:$PATH"
fi
export GOPATH="$HOME/go"

# Cargo (Rust)
if [ -d "$HOME/.cargo/bin" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# XDG
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# APM profile-managed directories
export APM_PROFILE_HOME="${APM_PROFILE_HOME:-$XDG_CONFIG_HOME/apm}"
export APM_AGENTS_DIR="${APM_AGENTS_DIR:-$APM_PROFILE_HOME/agents}"
export APM_SKILLS_DIR="${APM_SKILLS_DIR:-$APM_PROFILE_HOME/skills}"

# エディタ
export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-$EDITOR}"

# 言語
export LANG="${LANG:-ja_JP.UTF-8}"

# オプトアウト
export AZURE_MCP_COLLECT_TELEMETRY="false"
