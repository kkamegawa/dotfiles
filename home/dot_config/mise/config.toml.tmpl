[tools]
node = "lts"
npm = "latest"
python = ['3.13', '3.11', '3.12', '3.14']
"npm:@vscode/vsce" = "latest"
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") }}
go = "latest"
{{ end }}

[tasks.marketplace-sync]
description = "Register/update the tfsugjp Claude Code skills marketplace and enable user-scope plugins."
run = '''
claude plugin marketplace add tfsugjp/skills --scope user || claude plugin marketplace update tfsugjp-agent-skills
claude plugin install github-plan-wiki@tfsugjp-agent-skills -s user -y
claude plugin install dependabot-safe-merge@tfsugjp-agent-skills -s user -y
claude plugin install azure-devops-toolkit@tfsugjp-agent-skills -s user -y
codex plugin marketplace add tfsugjp/skills --scope user || codex plugin marketplace update tfsugjp-agent-skills
codex plugin install github-plan-wiki@tfsugjp-agent-skills -s user -y
codex plugin install dependabot-safe-merge@tfsugjp-agent-skills -s user -y
codex plugin install azure-devops-toolkit@tfsugjp-agent-skills -s user -y
copilot plugin marketplace add tfsugjp/skills --scope user || copilot plugin marketplace update tfsugjp-agent-skills
copilot plugin install github-plan-wiki@tfsugjp-agent-skills -s user -y
copilot plugin install dependabot-safe-merge@tfsugjp-agent-skills -s user -y
copilot plugin install azure-devops-toolkit@tfsugjp-agent-skills -s user -y
'''

[tasks.clean-old-pwsh-modules]
description = "Remove old Azure, Microsoft Entra, and Microsoft Graph PowerShell module versions."
run = 'dotnet run --file "{{ "{{" }} config_root {{ "}}" }}/.config/mise/oldpowershellmodule.cs"'

[tasks.clean-old-pwsh-modules-dry-run]
description = "Show old PowerShell module versions that would be removed."
run = 'dotnet run --file "{{ "{{" }} config_root {{ "}}" }}/.config/mise/oldpowershellmodule.cs" -- --dry-run'

[tasks.clean-old-nuget-package]
description = "Remove old NuGet package versions."
run = 'dotnet run --file "{{ "{{" }} config_root {{ "}}" }}/.config/mise/oldnugetpackages.cs"'

[tasks.clean-old-nuget-package-dry-run]
description = "Show old NuGet package versions that would be removed."
run = 'dotnet run --file "{{ "{{" }} config_root {{ "}}" }}/.config/mise/oldnugetpackages.cs" -- --dry-run'

[env]
# mise 管理の Python を uv のデフォルト Python として使う
# NOTE: 二重波括弧は mise 自身のテンプレート構文であり、chezmoi の Go テンプレートではない。
# chezmoi にリテラルとして出力させるためエスケープしている。
# `tools.python` はグローバルで複数バージョンを指定すると配列になるが、
# プロジェクトの mise.toml が単一バージョンで上書きすると単体のオブジェクトになる。
# どちらの形でも描画できるよう、型で分岐してパスを参照する。
UV_PYTHON = { value = "{% if tools.python is map %}{{ "{{" }} tools.python.path {{ "}}" }}{% else %}{{ "{{" }} tools.python[0].path {{ "}}" }}{% endif %}", tools = true }
