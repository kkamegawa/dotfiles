{{- $useGcm := false -}}
{{- $gcmHelper := "manager" -}}
{{- if .isWindows -}}
{{- $useGcm = true -}}
{{- else if .isMac -}}
{{- if lookPath "git-credential-manager" -}}
{{- $useGcm = true -}}
{{- else if and (eq .chezmoi.arch "arm64") (stat "/opt/homebrew/share/gcm-core/git-credential-manager") -}}
{{- $useGcm = true -}}
{{- $gcmHelper = "/opt/homebrew/share/gcm-core/git-credential-manager" -}}
{{- else if stat "/usr/local/share/gcm-core/git-credential-manager" -}}
{{- $useGcm = true -}}
{{- $gcmHelper = "/usr/local/share/gcm-core/git-credential-manager" -}}
{{- end -}}
{{- else if .isLinux -}}
{{- $gcmPath := lookPath "git-credential-manager" -}}
{{- $homeGitconfig := printf "%s/.gitconfig" (.chezmoi.homeDir | replace "\\" "/") -}}
{{- $configuredStore := "" -}}
{{- if stat $homeGitconfig -}}
{{- $configuredStore = output "git" "config" "--file" $homeGitconfig "--no-includes" "--default=" "--get" "credential.credentialStore" | trim -}}
{{- end -}}
{{- if and $gcmPath $configuredStore -}}
{{- $useGcm = true -}}
{{- end -}}
{{- end -}}
{{- $sshSignProgram := "" -}}
{{- if .isMac -}}
{{- $sshSignProgram = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" -}}
{{- else if .isWSL -}}
{{- $sshSignProgram = printf "/mnt/c/Users/%s/AppData/Local/1Password/app/8/op-ssh-sign-wsl.exe" .windowsUser -}}
{{- else if .isWindows -}}
{{- $sshSignProgram = printf "%s/AppData/Local/1Password/app/8/op-ssh-sign.exe" .chezmoi.homeDir -}}
{{- else if .isLinux -}}
{{- $sshSignProgram = "/opt/1Password/op-ssh-sign" -}}
{{- end -}}
{{- $sshSigningKey := printf "%s/.ssh/id_ed25519.pub" .chezmoi.homeDir -}}
{{- $enableCommitSigning := false -}}
{{- if and (not .isDevContainer) $sshSignProgram (stat $sshSignProgram) (stat $sshSigningKey) -}}
{{- $enableCommitSigning = true -}}
{{- end -}}

[user]
  name  = Kazushi Kamegawa
  email = kkamegawa@users.noreply.github.com
{{- if $enableCommitSigning }}
  signingkey = {{ $sshSigningKey }}
{{- end }}

[commit]
  gpgsign = {{ $enableCommitSigning }}

{{- if $enableCommitSigning }}
[gpg]
  format = ssh

[gpg "ssh"]
  program = {{ $sshSignProgram }}
{{- end }}

[core]
  autocrlf = {{ if .isWindows }}true{{ else }}input{{ end }}
  safecrlf = warn
  hooksPath = ~/.config/git/hooks
{{- if .isWindows }}
  fsmonitor = true
{{- end }}

[init]
  defaultBranch = main

[pull]
  rebase = true

[fetch]
  prune = true

[rebase]
  autoStash = true

[diff]
  colorMoved = default

[alias]
  lg  = log --oneline --graph --decorate --all
  st  = status -sb
  co  = checkout
  br  = branch
  cm  = commit -m
  psh = push --set-upstream origin HEAD

{{- if $useGcm }}
[credential]
  helper =
  helper = {{ $gcmHelper }}

[credential "https://github.com"]
  helper =
  helper = {{ $gcmHelper }}

[credential "https://gist.github.com"]
  helper =
  helper = {{ $gcmHelper }}
{{- end -}}
