{
  "version": 1,
  "defaults": {
    "minIntervalSeconds": 64800,
    "timeoutSeconds": 0
  },
  "commands": [
    {
      "name": "chezmoi upgrade",
      "enabled": true,
      "exe": "chezmoi",
      "args": [
        "upgrade"
      ]
    },
    {
      "name": "mise self-update",
      "enabled": true,
      "exe": "mise",
      "args": [
        "self-update",
        "-y"
      ]
    },
    {
      "name": "chezmoi update",
      "enabled": true,
      "exe": "chezmoi",
      "args": [
        "update"
      ]
    },
    {
      "name": "copilot update",
      "enabled": true,
      "exe": "winget",
      "args": [
        "upgrade",
        "GitHub.Copilot.Prerelease",
        "--force"
      ]
    },
    {
      "name": "winget",
      "enabled": true,
      "exe": "C:\\Windows\\System32\\sudo.exe",
      "args": [
        "winget",
        "upgrade",
        "--all",
        "--accept-package-agreements",
        "--silent"
      ]
    }
  ]
}
