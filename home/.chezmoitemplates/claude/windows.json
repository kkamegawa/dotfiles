{{- /* Managed Claude Code settings for Windows. Emits JSON. */ -}}
{{- $homeDir := .chezmoi.homeDir | replace "\\" "/" -}}
{
  "permissions": {
    "allow": [
      "Bash(where:*)",
      "Bash(vswhere:*)",
      "Bash(cygpath *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Get-Location)",
      "PowerShell(Test-Path *)",
      "PowerShell(Resolve-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(where.exe *)",
      "PowerShell(vswhere *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git remote -v)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git add *)",
      "PowerShell(git stash *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(gh pr *)",
      "PowerShell(gh issue *)",
      "PowerShell(gh release *)",
      "PowerShell(gh stack view *)",
      "PowerShell(az repos *)",
      "PowerShell(az boards *)",
      "PowerShell(az pipelines *)",
      "PowerShell(az account show)",
      "PowerShell(dotnet --info)",
      "PowerShell(dotnet --list-sdks)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet format *)",
      "PowerShell(node -v)",
      "PowerShell(npm ci)",
      "PowerShell(npm test *)",
      "PowerShell(codex --version)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f *)",
      "PowerShell(git clean -fd *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git rebase *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Read(~/AppData/Roaming/GitHub CLI/**)"
    ],
    "additionalDirectories": [
      "{{ $homeDir }}/AppData/Local/Temp/Kkamegawa.CodexForVisualStudio",
      "{{ $homeDir }}/AppData/Local/Temp/VSLogs",
      "{{ $homeDir }}/AppData/Local/Temp/servicehub/logs",
      "{{ $homeDir }}/.nuget/packages",
      "{{ $homeDir }}/.dotnet/tools",
      "{{ $homeDir }}/AppData/Local/NuGet/v3-cache"
{{- range glob (printf "%s/AppData/Local/Microsoft/VisualStudio/*/Settings" $homeDir) }},
      "{{ . | replace "\\" "/" }}"
{{- end }}{{- range glob (printf "%s/AppData/Local/Microsoft/VisualStudio/*/Extensions" $homeDir) }},
      "{{ . | replace "\\" "/" }}"
{{- end }}{{- range glob (printf "%s/AppData/Local/Microsoft/VisualStudio/*/VSExtensions" $homeDir) }},
      "{{ . | replace "\\" "/" }}"
{{- end }}
    ]
  }
}
