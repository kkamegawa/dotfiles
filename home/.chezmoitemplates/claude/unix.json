{{- /* Managed Claude Code settings for macOS and Linux. Emits JSON. */ -}}
{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/tmp/.dotnet",
        "/private/tmp/.dotnet"
      ]
    }
  }
}
