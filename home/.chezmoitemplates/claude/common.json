{{- /* Managed Claude Code settings shared by every OS. Emits JSON. */ -}}
{{- $p := includeTemplate "claude/paths" . | fromJson -}}
{{- $claudeHome := $p.claudeHome -}}
{{- $dotnetRoot := printf "%s/.local/share/mise/dotnet-root" (.chezmoi.homeDir | replace "\\" "/") -}}
{{- $claudePath := list $dotnetRoot (printf "%s/.dotnet/tools" (.chezmoi.homeDir | replace "\\" "/")) (printf "%s/.local/bin" (.chezmoi.homeDir | replace "\\" "/")) (printf "%s/.local/share/mise/shims" (.chezmoi.homeDir | replace "\\" "/")) -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- range $entry := splitList ":" (env "PATH") -}}
{{- if and $entry (not (has $entry $claudePath)) -}}{{- $claudePath = append $claudePath $entry -}}{{- end -}}
{{- end -}}
{{- end -}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "advisorModel": "opus",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"{{ if eq .chezmoi.os "darwin" }},
    "DOTNET_ROOT": {{ $dotnetRoot | toJson }},
    {{ if eq .chezmoi.arch "arm64" }}"DOTNET_ROOT_ARM64": {{ $dotnetRoot | toJson }},{{ else }}"DOTNET_ROOT_X64": {{ $dotnetRoot | toJson }},{{ end }}
    "PATH": {{ join ":" $claudePath | toJson }}{{ end }}
  },
  "permissions": {
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(gh issue:*)",
      "Bash(gh stack view *)",
      "Bash(az repos:*)",
      "Bash(az boards:*)",
      "Bash(az pipelines:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git commit:*)",
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet add package:*)",
      "Bash(dotnet new install:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(dotnet tool install:*)",
      "Bash(dotnet tool restore:*)",
      "Bash(dotnet tool update:*)",
      "Bash(dotnet workload install:*)",
      "Bash(dotnet workload restore:*)",
      "Bash(dotnet workload update:*)",
      "Bash(dotnet workload repair:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(az account show)",
      "Bash(az extension show *)",
      "Bash(az devops configure --list)",
      "Bash(az devops project show *)",
      "Bash(az boards work-item show *)",
      "Bash(node -v)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(codex --version)",
      "mcp__microsoft-learn__microsoft_docs_search",
      "Bash(pwsh -v)",
      "Bash(pwsh -File:*)",
      "Bash(pwsh -Command:*)",
      "Bash(Invoke-Pester:*)"
    ],
    "ask": [
      "Bash(dotnet ef database update:*)",
      "Bash(npm publish:*)",
      "Bash(dotnet nuget push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.claude/settings.json)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(cat .env:*)",
      "Bash(printenv:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["{{ $claudeHome }}/hooks/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["{{ $claudeHome }}/hooks/format.mjs"],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            {{ if eq .chezmoi.os "darwin" }}
            "command": {{ printf "%s/.local/bin/dotfiles-dotnet10" (.chezmoi.homeDir | replace "\\" "/") | toJson }},
            "args": ["run", "--file", "{{ $claudeHome }}/hooks/compaction-recovery.cs"],
            {{ else }}
            "command": "dotnet",
            "args": ["run", "{{ $claudeHome }}/hooks/compaction-recovery.cs"],
            {{ end }}
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            {{ if eq .chezmoi.os "darwin" }}
            "command": {{ printf "%s/.local/bin/dotfiles-dotnet10" (.chezmoi.homeDir | replace "\\" "/") | toJson }},
            "args": ["run", "--file", "{{ $claudeHome }}/hooks/userpromptsubmit-compaction-recovery.cs"],
            {{ else }}
            "command": "dotnet",
            "args": ["run", "{{ $claudeHome }}/hooks/userpromptsubmit-compaction-recovery.cs"],
            {{ end }}
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node",
    "args": ["{{ $claudeHome }}/hooks/statusline.mjs"],
    "timeout": 5
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "git",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      }
    },
    "tfsugjp-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/tfsugjp/skills.git"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "failIfUnavailable": false,
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "dev.azure.com",
        "ssh.dev.azure.com",
        "mcp.dev.azure.com",
        "*.visualstudio.com",
        "pkgs.dev.azure.com",
        "registry.npmjs.org",
        "npmjs.com",
        "api.nuget.org",
        "*.nuget.org",
        "pypi.org",
        "files.pythonhosted.org",
        "dotnetcli.azureedge.net",
        "dotnetcli.blob.core.windows.net",
        "aka.ms",
        "dotnet.microsoft.com"
      ]
    },
    "filesystem": {
      {{ if eq .chezmoi.os "darwin" }}"allowRead": [{{ $dotnetRoot | toJson }}],{{ end }}
      "allowWrite": [
        "~/.dotnet",
        "~/.nuget",
        "~/.npm",
        "~/.azure",
        "~/.local/share/mise",
        "~/.cache"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "AZURE_DEVOPS_EXT_PAT", "mode": "deny" },
        { "name": "NUGET_API_KEY", "mode": "deny" }
      ]
    },
    "excludedCommands": [
      "docker",
      "gh",
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git clone *",
      "git ls-remote *",
      "dotnet *",
      "cmd.exe",
      "wslc"
    ]
  },
  "enableWorkflows": true,
  "attribution": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "subagentPromptCacheTtl": "1h",
  "language": "japanese",
  "cleanupPeriodDays": 60
}
