{{- $homeDir := .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $homeDir = env "USERPROFILE" -}}
{{- end -}}

{{- $cacheRoot := "" -}}
{{- $pathSep := "/" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $cacheRoot = printf "%s/Library/Caches/codex-dev" $homeDir -}}
{{- else if eq .chezmoi.os "windows" -}}
{{- $cacheRoot = printf "%s\\AppData\\Local\\codex-dev" $homeDir -}}
{{- $pathSep = "\\" -}}
{{- else -}}
{{- $cacheRoot = printf "%s/.cache/codex-dev" $homeDir -}}
{{- end -}}

# Codex local development config.toml

approval_policy = "on-request"
approvals_reviewer = "auto_review"
default_permissions = "dotnet-dev"

# Avoid loading arbitrary shell startup scripts into agent commands.
allow_login_shell = false

# Cached search does not grant spawned commands unrestricted web access.
web_search = "indexed"

sandbox_mode = "workspace-write"

# Workspace editing with read-only user NuGet config access.
[permissions.dotnet-dev]
description = "Workspace build with read-only NuGet config and scoped package registry access."
extends = ":workspace"

[permissions.dotnet-dev.filesystem]
{{ $cacheRoot | quote }} = "write"
{{- if eq .chezmoi.os "windows" }}
{{ printf "%s\\AppData\\Roaming\\NuGet" $homeDir | quote }} = "read"
{{ printf "%s\\.nuget\\plugins\\netcore" $homeDir | quote }} = "read"
{{ printf "%s\\.azure" $homeDir | quote }} = "write"
{{- else if eq .chezmoi.os "darwin" }}
{{ printf "%s/.config/NuGet" $homeDir | quote }} = "read"
{{ printf "%s/.nuget/NuGet" $homeDir | quote }} = "read"
{{ printf "%s/.nuget/plugins/netcore" $homeDir | quote }} = "read"
{{ printf "%s/.azure" $homeDir | quote }} = "write"
{{- else }}
{{ printf "%s/.config/NuGet" $homeDir | quote }} = "read"
{{ printf "%s/.nuget/NuGet" $homeDir | quote }} = "read"
{{ printf "%s/.nuget/plugins/netcore" $homeDir | quote }} = "read"
{{ printf "%s/.azure" $homeDir | quote }} = "write"
{{- end }}

[permissions.dotnet-dev.network]
enabled = true
allow_local_binding = false
allow_upstream_proxy = true

[permissions.dotnet-dev.network.domains]
"login.microsoftonline.com" = "allow"
"management.azure.com" = "allow"
"graph.microsoft.com" = "allow"
"dev.azure.com" = "allow"
"**.dev.azure.com" = "allow"
"**.visualstudio.com" = "allow"
"aka.ms" = "allow"
"**.blob.core.windows.net" = "allow"
"**.azureedge.net" = "allow"
"**.nuget.org" = "allow"
"registry.npmjs.org" = "allow"
"registry.yarnpkg.com" = "allow"
"pkgs.dev.azure.com" = "allow"
"**.pkgs.visualstudio.com" = "allow"
"nuget.pkg.github.com" = "allow"
"npm.pkg.github.com" = "allow"
"localhost" = "allow"
"127.0.0.1" = "allow"
"::1" = "allow"

[features]
js_repl = false
memories = true

# Keep the network proxy enabled for the selected permissions profile.
[features.network_proxy]
enabled = true
allow_local_binding = false
allow_upstream_proxy = true

[features.network_proxy.domains]
"**.nuget.org" = "allow"
"registry.npmjs.org" = "allow"
"registry.yarnpkg.com" = "allow"
"login.microsoftonline.com" = "allow"
"management.azure.com" = "allow"
"graph.microsoft.com" = "allow"
"dev.azure.com" = "allow"
"**.dev.azure.com" = "allow"
"**.visualstudio.com" = "allow"
"aka.ms" = "allow"
"**.blob.core.windows.net" = "allow"
"**.azureedge.net" = "allow"

# Azure Artifacts package feeds.
"pkgs.dev.azure.com" = "allow"
"**.pkgs.visualstudio.com" = "allow"

# Optional: private packages hosted by GitHub Packages.
"nuget.pkg.github.com" = "allow"
"npm.pkg.github.com" = "allow"

# Permit local development servers and local integration tests.
"localhost" = "allow"
"127.0.0.1" = "allow"
"::1" = "allow"

# Keep common secret-bearing environment variables out of child processes.
[shell_environment_policy]
inherit = "all"
exclude = [
  "AZURE_*",
  "AWS_*",
  "GITHUB_*",
  "VSS_NUGET_EXTERNAL_FEED_ENDPOINTS",
]

# Keep .NET and JavaScript package-manager caches outside the repository,
# but inside the dedicated writable cache root.
[shell_environment_policy.set]
DOTNET_CLI_HOME = {{ printf "%s%sdotnet-cli" $cacheRoot $pathSep | quote }}
NUGET_PACKAGES = {{ printf "%s%snuget-packages" $cacheRoot $pathSep | quote }}
NUGET_HTTP_CACHE_PATH = {{ printf "%s%snuget-http-cache" $cacheRoot $pathSep | quote }}
NUGET_SCRATCH = {{ printf "%s%snuget-scratch" $cacheRoot $pathSep | quote }}
NUGET_PLUGINS_CACHE_PATH = {{ printf "%s%snuget-plugins-cache" $cacheRoot $pathSep | quote }}
npm_config_cache = {{ printf "%s%snpm-cache" $cacheRoot $pathSep | quote }}
pnpm_config_store_dir = {{ printf "%s%spnpm-store" $cacheRoot $pathSep | quote }}
YARN_CACHE_FOLDER = {{ printf "%s%syarn-cache" $cacheRoot $pathSep | quote }}

{{- if eq .chezmoi.os "windows" }}
# Preferred native Windows sandbox.
# Change only to "unelevated" when corporate policy or setup prevents elevated mode.
[windows]
sandbox = "elevated"
sandbox_private_desktop = true
{{- end }}

[desktop]
followUpQueueMode = "steer"
show-context-window-usage = true
composerEnterBehavior = "cmdAlways"
enabled-reasoning-efforts = ["low", "medium", "high", "xhigh", "ultra", "max"]
open-local-url-in-target-preference = "external-browser"
git-pull-request-merge-method = "squash"
worktree-upstream-refresh-mode = "best-effort"

[mcp_servers.learn_mcp]
enabled = true
url = "https://learn.microsoft.com/api/mcp"

[agents]
max_concurrent_threads_per_session = 100
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "max"

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."sites@openai-bundled"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[sandbox_workspace_write]
network_access = true

[memories]
generate_memories = true
use_memories = true
